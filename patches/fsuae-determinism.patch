+/* Lockstep for deterministic mode with the indirect UAE board. The indirect board runs every
+ * trap on a host thread (hardware_trap_thread), directory-drive packets run on another
+ * (filesys_thread), and the 68k performs their memory accesses (call_hardware_trap_back),
+ * which keeps an emulated data cache coherent. Those threads must not race emulated time.
+ * Whoever makes a taking-part thread runnable counts it (trap_lockstep_wake), the thread
+ * drops the count before it next blocks (trap_lockstep_release), and the emulation thread
+ * waits after each handoff until no such thread runs (trap_lockstep_sync). A host thread's
+ * effects then land at the emulated instant of the handoff that started it. */
+static std::atomic<int> lockstep_running;
+static std::atomic<bool> lockstep_back_waiting[TRAP_THREADS];
+static thread_local bool lockstep_thread, lockstep_holding;
+
+bool trap_lockstep(void)
+{
+	return uae_deterministic_mode() && trap_is_indirect();
+}
+
+// The calling thread takes part: from now on it runs only while the emulation thread waits.
+void trap_lockstep_thread(void)
+{
+	lockstep_thread = true;
+}
+
+void trap_lockstep_wake(void)
+{
+	if (trap_lockstep())
+		lockstep_running++;
+}
+
+// A taking-part thread woke up for a trap_lockstep_wake().
+void trap_lockstep_take(void)
+{
+	if (lockstep_thread && trap_lockstep())
+		lockstep_holding = true;
+}
+
+void trap_lockstep_release(void)
+{
+	if (lockstep_holding) {
+		lockstep_holding = false;
+		lockstep_running--;
+	}
+}
+
+// The 68k acknowledged a call_hardware_trap_back(): count the thread waiting for it, before
+// the acknowledgement it can see is stored.
+void trap_lockstep_back_ack(int trap_slot)
+{
+	if (trap_slot >= 0 && trap_slot < TRAP_THREADS && lockstep_back_waiting[trap_slot].exchange(false))
+		lockstep_running++;
+}
+
+void trap_lockstep_sync(void)
+{
+	if (!trap_lockstep())
+		return;
+	while (lockstep_running > 0)
+		std::this_thread::yield();
+}
