+	// The next request without consuming it: "\x03" for Ctrl-C, the body of a packet once
+	// all of it has arrived, empty while only acks or part of a packet are waiting. acks: the
+	// number of ack characters before it; SIZE_MAX at end of stream or on an error.
+	std::string peek_request(size_t* acks) {
+		char buf[512];
+		auto n = recv(gdbconn, buf, sizeof(buf) - 1, MSG_PEEK);
+		if(acks)
+			*acks = n <= 0 ? SIZE_MAX : 0;
+		if(n <= 0)
+			return {};
+		std::string r(buf, n);
+		auto i = r.find_first_not_of("+-");
+		if(acks)
+			*acks = i == std::string::npos ? r.size() : i;
+		if(i == std::string::npos)
+			return {};
+		if(r[i] != '$')
+			return r.substr(i, 1);
+		auto end = r.find('#', i);
+		if(end == std::string::npos || end + 2 >= r.size())
+			return {};
+		return r.substr(i + 1, end - i - 1);
+	}
