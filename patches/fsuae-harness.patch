+	// Requests a parked stop can serve: memory, harness commands, queries and continue.
+	// Registers, steps, breakpoints and anything else need the CPU at an instruction boundary.
+	bool parked_request(const std::string& r) {
+		if(r.empty())
+			return true;
+		switch(r[0]) {
+		case 'm': case 'M': case 'X': case '?': case 'H': case 'T': case 'Q': case 'k': case 'D':
+			return true;
+		case 'q':
+			if(r.substr(0, strlen("qRcmd,")) == "qRcmd,") {
+				auto cmd = from_hex(r.substr(strlen("qRcmd,")));
+				for(auto safe : { "fields ", "profile ", "key ", "mouse ", "input ", "input-state", "harness", "memory " })
+					if(cmd.substr(0, strlen(safe)) == safe)
+						return true;
+				return false;
+			}
+			return true;
+		case 'v':
+			return r == "vCont;c" || r.substr(0, strlen("vCont;c:")) == "vCont;c:" || r == "vCont?";
+		}
+		return false;
+	}
