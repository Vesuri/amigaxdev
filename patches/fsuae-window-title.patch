+static void describe_size(char *buffer, int size, uae_u32 bytes, const char *kind)
+{
+    int len = strlen(buffer);
+    if (bytes == 0 || len >= size) {
+        return;
+    }
+    if (bytes % (1024 * 1024) == 0) {
+        snprintf(buffer + len, size - len, " %uMB %s", bytes / (1024 * 1024), kind);
+    } else {
+        snprintf(buffer + len, size - len, " %uKB %s", bytes / 1024, kind);
+    }
+}
+
+// AmigaXDev: the machine as UAE runs it (model defaults included), for the window title.
+void amiga_describe_machine(char *buffer, int size)
+{
+    const struct uae_prefs *p = &currprefs;
+    // 24-bit addressing on a 68020/68030 is the EC part (the A1200's 68EC020).
+    bool ec = p->address_space_24 && (p->cpu_model == 68020 || p->cpu_model == 68030);
+    const char *chipset = (p->chipset_mask & CSMASK_AGA) ? "AGA"
+        : (p->chipset_mask & (CSMASK_ECS_AGNUS | CSMASK_ECS_DENISE)) ? "ECS" : "OCS";
+    snprintf(buffer, size, "68%s0%d0%s%s %s%s", ec ? "EC" : "", (p->cpu_model / 10) % 10,
+             p->mmu_model ? " MMU" : "", p->fpu_model ? " FPU" : "", chipset,
+             p->ntscmode ? " NTSC" : "");
+    uae_u32 fast = p->mbresmem_low.size + p->mbresmem_high.size + p->mem25bit.size
+        + p->cpuboardmem1.size + p->cpuboardmem2.size;
+    for (int i = 0; i < MAX_RAM_BOARDS; i++) {
+        fast += p->fastmem[i].size + p->z3fastmem[i].size;
+    }
+    describe_size(buffer, size, p->chipmem.size, "CHIP");
+    describe_size(buffer, size, p->bogomem.size, "SLOW");
+    describe_size(buffer, size, fast, "FAST");
+}
