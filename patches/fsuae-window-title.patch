+// AmigaXDev: the --title text, where {machine} becomes the running machine.
+static const char *g_window_title = "FS-UAE";
+
+static void set_window_title(const char *machine)
+{
+    char title[256];
+    const char *token = strstr(g_window_title, "{machine}");
+    if (token) {
+        snprintf(title, sizeof(title), "%.*s%s%s", (int) (token - g_window_title),
+                 g_window_title, machine, token + strlen("{machine}"));
+    } else {
+        snprintf(title, sizeof(title), "%s", g_window_title);
+    }
+    fsemu_window_set_title(title);
+}
+
+// Once per frame on the emulation thread: the prefs are final after the first reset,
+// and a configuration change (a new model, more memory) renames the window.
+static void update_window_title(void)
+{
+    static char last[128];
+    char machine[128];
+    if (!strstr(g_window_title, "{machine}")) {
+        return;
+    }
+    amiga_describe_machine(machine, sizeof(machine));
+    if (strcmp(machine, last) != 0) {
+        strcpy(last, machine);
+        set_window_title(machine);
+    }
+}
