+static void fsemu_window_update_title(void)
+{
+    if (!fsemu_window.title_mutex || !fsemu_sdlwindow_has_window()) {
+        return;
+    }
+    fsemu_mutex_lock(fsemu_window.title_mutex);
+    bool changed = fsemu_window.title_changed;
+    if (changed) {
+        memcpy(fsemu_window.title, fsemu_window.pending_title, FSEMU_WINDOW_TITLE_MAX);
+        fsemu_window.title_changed = false;
+    }
+    fsemu_mutex_unlock(fsemu_window.title_mutex);
+    if (changed) {
+        // The OS window name; fsemu_titlebar_update redraws the drawn title bar.
+        fsemu_sdlwindow_set_title(fsemu_window.title);
+    }
 }
 
