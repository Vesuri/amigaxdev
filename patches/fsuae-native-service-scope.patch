+// APROF: whole-address-space cycle profiler with a calling-context tree.
+#include <unordered_map>
+#include "NativeServiceScope.h"
+static NativeServiceScope native_scope;
+// RTS updates regs.instruction_pc; freeze the executed identity before dispatch.
+static uae_u32 native_pc;
+static uae_u16 native_opcode;
+struct aprof_frame { uae_u32 ret; uae_u32 node; uae_u8 kind; };
+struct aprof_node { uae_u32 parent; uae_u32 target; uae_u8 kind; uae_u64 self; uae_u64 calls; };
+bool aprof_on = false;
+evt_t aprof_chip_acc = 0;
+uae_u32 aprof_chip_cnt = 0;
+static uae_u64 *aprof_chip = nullptr, aprof_chip_total = 0, aprof_chip_accesses = 0;
+static uae_u32 *aprof_chipn = nullptr;
+static evt_t aprof_last = 0, aprof_start_cycles = 0;
+static uae_u32 aprof_start_vsync = 0;
+static uae_u64 *aprof_cyc = nullptr;
+static uae_u32 *aprof_cnt = nullptr;
+static uae_u64 aprof_hi_cyc = 0, aprof_gap = 0;
+struct aprof_linea_cost { uae_u64 units=0,calls=0; };
+static std::unordered_map<uae_u32,aprof_linea_cost> aprof_linea;
+static std::vector<aprof_node> aprof_nodes;
+static std::unordered_map<uae_u64, uae_u32> aprof_children;
+static aprof_frame aprof_stack[512];
+static int aprof_depth = 0;
+static uae_u64 aprof_overflow = 0, aprof_unmatched_rts = 0, aprof_unmatched_rte = 0;
+extern uae_u32 vsync_counter;
+
+static uae_u32 aprof_child(uae_u32 parent, uae_u32 target, uae_u8 kind)
+{
+	uae_u64 key = ((uae_u64)parent << 34) ^ ((uae_u64)kind << 32) ^ target;
+	auto it = aprof_children.find(key);
+	if (it != aprof_children.end())
+		return it->second;
+	uae_u32 id = (uae_u32)aprof_nodes.size();
+	aprof_nodes.push_back({parent, target, kind, 0, 0});
+	aprof_children.emplace(key, id);
+	return id;
+}
+
+static void aprof_push(uae_u32 target, uae_u32 ret, uae_u8 kind)
+{
+	if (aprof_depth >= 512) {
+		// Drop the oldest half; leaked frames (longjmp-like control flow) must not wedge us.
+		memmove(aprof_stack, aprof_stack + 256, 256 * sizeof(aprof_frame));
+		aprof_depth = 256;
+		aprof_overflow++;
+	}
+	uae_u32 parent = aprof_depth ? aprof_stack[aprof_depth - 1].node : 0;
+	uae_u32 node = aprof_child(parent, target, kind);
+	aprof_nodes[node].calls++;
+	aprof_stack[aprof_depth++] = {ret, node, kind};
+}
+
+static void aprof_pop(uae_u32 newpc, bool rte)
+{
+	for (int i = aprof_depth - 1; i >= 0 && i >= aprof_depth - 64; i--) {
+		const aprof_frame &fr = aprof_stack[i];
+		if (fr.ret == newpc || ((fr.kind == 10 || fr.kind == 11) && fr.ret + 2 == newpc)) {
+			aprof_depth = i;
+			return;
+		}
+	}
+	if (rte) aprof_unmatched_rte++; else aprof_unmatched_rts++;
+}
+
+bool aprof_native(unsigned low,unsigned high,unsigned a,unsigned b,unsigned c)
+{
+    if(aprof_on || low>=high || !a || !b || !c || a==b || a==c || b==c ||
+       (a|b|c)&1 || a<low || a>=high || b<low || b>=high || c<low || c>=high ||
+       get_word_debug(a)!=0x4e73 || get_word_debug(b)!=0x4e73 || get_word_debug(c)!=0x4e75)
+        return false;
+    // Exec's negative library vectors are native OS calls, not original callbacks.
+    uae_u32 exec=get_long_debug(4),negative=get_word_debug(exec+16);
+    if(exec<negative || !negative || negative>4096)return false;
+    uae_u32 supervisor=get_long_debug(exec-28);
+    if(get_word_debug(supervisor)!=0x007c || get_word_debug(supervisor+2)!=0x2000)return false;
+    native_scope.configure(a,b,c,low,high);
+    native_scope.execLow=exec-negative;native_scope.execHigh=exec;
+    native_scope.supervisor=supervisor;
+    return true;
+}
+
+// Only m68k_run_2ce and m68k_run_3ce are instrumented: refuse other CPU loops rather than report nothing.
+bool aprof_start(void)
+{
+	if (!currprefs.cpu_cycle_exact || currprefs.cpu_model < 68020 || currprefs.mmu_model)
+		return false;
+	if (!aprof_cyc) {
+		aprof_cyc = (uae_u64 *)calloc(1 << 24, sizeof(uae_u64));
+		aprof_cnt = (uae_u32 *)calloc(1 << 24, sizeof(uae_u32));
+		aprof_chip = (uae_u64 *)calloc(1 << 24, sizeof(uae_u64));
+		aprof_chipn = (uae_u32 *)calloc(1 << 24, sizeof(uae_u32));
+	} else {
+		memset(aprof_chip, 0, (1 << 24) * sizeof(uae_u64));
+		memset(aprof_chipn, 0, (1 << 24) * sizeof(uae_u32));
+		memset(aprof_cyc, 0, (1 << 24) * sizeof(uae_u64));
+		memset(aprof_cnt, 0, (1 << 24) * sizeof(uae_u32));
+	}
+	native_scope.reset();
+	aprof_linea.clear();
+	aprof_nodes.clear();
+	aprof_children.clear();
+	aprof_nodes.push_back({0, 0, 0, 0, 0}); // root
+	aprof_depth = 0;
+	aprof_hi_cyc = aprof_gap = aprof_overflow = aprof_unmatched_rts = aprof_unmatched_rte = 0;
+	aprof_chip_acc = 0; aprof_chip_cnt = 0; aprof_chip_total = aprof_chip_accesses = 0;
+	aprof_start_cycles = aprof_last = get_cycles();
+	aprof_start_vsync = vsync_counter;
+	aprof_on = true;
+	return true;
+}
+
+bool aprof_stop(const char *path)
+{
+	if (!aprof_on)
+		return false;
+	aprof_on = false;
+	FILE *f = fopen(path, "w");
+	if (!f)
+		return false;
+	// Times are emulated cycle units: CYCLE_UNIT per colour clock.
+	fprintf(f, "APROF 1\n");
+	fprintf(f, "units %llu\nvsyncs %u\ncycleunit %d\nCYCLE_UNIT %d\ncolorclock_hz %d\n",
+		(unsigned long long)(get_cycles() - aprof_start_cycles), vsync_counter - aprof_start_vsync, cpucycleunit, CYCLE_UNIT,
+		currprefs.ntscmode ? 3579545 : 3546895);
+	fprintf(f, "cacr %x\ncpu_model %d\n", regs.cacr, currprefs.cpu_model);
+	fprintf(f, "gap %llu\nhigh %llu\noverflow %llu\nunmatched_rts %llu\nunmatched_rte %llu\n",
+		(unsigned long long)aprof_gap, (unsigned long long)aprof_hi_cyc, (unsigned long long)aprof_overflow,
+		(unsigned long long)aprof_unmatched_rts, (unsigned long long)aprof_unmatched_rte);
+	fprintf(f, "chip_units %llu\nchip_accesses %llu\n", (unsigned long long)aprof_chip_total, (unsigned long long)aprof_chip_accesses);
+	for (uae_u32 i = 0; i < (1u << 24); i++)
+		if (aprof_cnt[i] || aprof_cyc[i])
+			fprintf(f, "P %x %llu %u %llu %u\n", i < (1u << 23) ? i << 1 : 0x40000000u + ((i - (1u << 23)) << 1), (unsigned long long)aprof_cyc[i], aprof_cnt[i],
+				(unsigned long long)aprof_chip[i], aprof_chipn[i]);
+	for (size_t i = 0; i < aprof_nodes.size(); i++) {
+		const auto &n = aprof_nodes[i];
+		fprintf(f, "N %zu %u %x %u %llu %llu\n", i, n.parent, n.target, n.kind,
+			(unsigned long long)n.self, (unsigned long long)n.calls);
+	}
+	fprintf(f,"executed_pc_frozen 1\nlinea_entry_version 1\n");
+    for(const auto& row:aprof_linea) {
+        fprintf(f,"linea_%08x_units %llu\nlinea_%08x_calls %llu\n",row.first,
+            (unsigned long long)row.second.units,row.first,(unsigned long long)row.second.calls);
+    }
+	native_scope.write(f);
+	fclose(f);
+	return true;
+}
+
+// Called by Exception_normal after the frame is built; nr is the vector.
+void aprof_exception(int nr)
+{
+	if (!aprof_on && !native_scope.enabled)
+		return;
+	uae_u32 ret = get_long_debug(m68k_areg(regs, 7) + 2);
+	native_scope.exception(nr,ret,nr==10?get_word_debug(ret):0,aprof_on,
+        nr==8 && ret==native_scope.supervisor);
+	if(!aprof_on)return;
+	// Line-A: key the context by the trap word, since every trap enters one handler.
+	uae_u32 target = nr == 10 ? (0xa0000000u | get_word_debug(ret)) : m68k_getpc();
+	aprof_push(target, ret, (uae_u8)(nr < 255 ? nr : 255));
+	// kind = vector number (never 0: vector 0 is the reset SSP)
+}
+
+static inline void aprof_before(void)
+{
+	evt_t now = get_cycles();
+	evt_t d = now - aprof_last;
+	// Cycles outside instruction bodies: interrupt entry, STOP idle, etc.
+	native_scope.charge(d);
+	aprof_gap += d;
+	aprof_nodes[aprof_depth ? aprof_stack[aprof_depth - 1].node : 0].self += d;
+	aprof_last = now;
+}
+
+static inline void aprof_after(uae_u32 pc, uae_u16 opcode)
+{
+    if(!aprof_on){native_scope.after(native_pc,native_opcode,m68k_getpc(),false);return;}
+	evt_t now = get_cycles();
+	evt_t d = now - aprof_last;
+	aprof_last = now;
+	// Validate only an executed negative vector, including its current target.
+    bool osVector=native_pc>=native_scope.execLow && native_pc<native_scope.execHigh &&
+        (native_scope.execHigh-native_pc)%6==0 && get_word_debug(native_pc)==0x4ef9 &&
+        get_long_debug(native_pc+2)>=0xf80000 && get_long_debug(native_pc+2)<0x1000000;
+    native_scope.charge(d,native_pc,osVector);
+	native_scope.after(native_pc,native_opcode,m68k_getpc(),true);
+    if((opcode&0xf000)==0xa000){aprof_linea[pc].units+=d;++aprof_linea[pc].calls;}
+	// 24-bit space, then the 16 MB Z3 window at 0x40000000.
+	uae_u32 slot = pc < 0x1000000 ? pc >> 1 : pc - 0x40000000u < 0x1000000 ? (1u << 23) + ((pc - 0x40000000u) >> 1) : ~0u;
+	if (slot != ~0u) {
+		aprof_cyc[slot] += d;
+		aprof_cnt[slot]++;
+		if (aprof_chip_cnt) {
+			aprof_chip[slot] += aprof_chip_acc;
+			aprof_chipn[slot] += aprof_chip_cnt;
+		}
+	} else {
+		aprof_hi_cyc += d;
+	}
+	aprof_chip_total += aprof_chip_acc; aprof_chip_accesses += aprof_chip_cnt;
+	aprof_chip_acc = 0; aprof_chip_cnt = 0;
+	// Attribute to the context that executed the instruction; calls below change it.
+	aprof_nodes[aprof_depth ? aprof_stack[aprof_depth - 1].node : 0].self += d;
+	if ((opcode & 0xffc0) == 0x4e80 || (opcode & 0xff00) == 0x6100) {
+		// JSR/BSR: return address is now on top of the active stack.
+		aprof_push(m68k_getpc(), get_long_debug(m68k_areg(regs, 7)), 0);
+	} else if (opcode == 0x4e75 || opcode == 0x4e74 || opcode == 0x4e77) {
+		aprof_pop(m68k_getpc(), false);
+	} else if (opcode == 0x4e73) {
+		aprof_pop(m68k_getpc(), true);
+	}
+}
+// APROF-END
