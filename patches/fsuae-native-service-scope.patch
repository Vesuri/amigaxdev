diff --git a/src/include/NativeServiceScope.h b/src/include/NativeServiceScope.h
new file mode 100644
index 0000000..c54d775
--- /dev/null
+++ b/src/include/NativeServiceScope.h
@@ -0,0 +1,85 @@
+#pragma once
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+// Host-only instruction accounting. Guest return boundaries are supplied by
+// its verified ELF; no guest instruction or emulated cycle is added.
+struct NativeServiceScope {
+    struct Cost { uint64_t units,calls,returns,irq,foreign; uint32_t before; };
+    Cost cost[4096];
+    uint16_t traps[64]; uint32_t entryPC[64],irqReturns[64];
+    unsigned depth=0,irqDepth=0,irqBefore=0;
+    uint32_t exits[3]={},textLow=0,textHigh=0,execLow=0,execHigh=0,supervisor=0;
+    uint64_t privilegeCalls=0,prefixReturns=0;
+    uint64_t faults=0,irqEntered=0,irqExited=0,unscoped=0;
+    bool enabled=false,prefix=true;
+    void configure(uint32_t a,uint32_t b,uint32_t c,uint32_t low=0,uint32_t high=0xffffffffu) {
+        textLow=low;textHigh=high;
+        depth=irqDepth=0;exits[0]=a;exits[1]=b;exits[2]=c;
+        enabled=true;prefix=true;faults=0;privilegeCalls=0;execLow=execHigh=supervisor=0;reset();
+    }
+    void reset() {
+        memset(cost,0,sizeof(cost));irqEntered=irqExited=unscoped=privilegeCalls=prefixReturns=0;
+        irqBefore=irqDepth;
+        for(unsigned i=0;i<depth;++i)++cost[traps[i]].before;
+    }
+    void exception(unsigned vector,uint32_t returned,uint16_t trap,bool measuring,bool supervisorCall=false) {
+        if(!enabled)return;
+        if(vector>=24 && vector<=31) {
+            if(irqDepth==64){++faults;return;}
+            irqReturns[irqDepth++]=returned;
+            if(measuring)++irqEntered;
+        } else if(vector==10 && !irqDepth) {
+            if(depth==64){++faults;return;}
+            entryPC[depth]=returned;traps[depth++]=trap&4095;prefix=false;
+            if(measuring)++cost[trap&4095].calls;
+        } else if(vector==8 && supervisorCall) {
+            if(measuring)++privilegeCalls; // Required Exec Supervisor work stays charged.
+        } else if(vector!=10 && depth)++faults;
+    }
+    void charge(uint64_t units,uint32_t pc=0,bool osVector=false) {
+        if(!enabled)return;
+        if(depth) {
+            if(irqDepth)cost[traps[depth-1]].irq+=units;
+            else {
+                Cost& c=cost[traps[depth-1]];c.units+=units;
+                if(pc && pc!=entryPC[depth-1] && !(pc>=textLow && pc<textHigh)
+                   && !(osVector && pc>=execLow && pc<execHigh && (execHigh-pc)%6==0)
+                   && !(pc>=0xf80000 && pc<0x1000000))c.foreign+=units;
+            }
+        } else unscoped+=units;
+    }
+    void after(uint32_t pc,uint16_t opcode,uint32_t next,bool measuring) {
+        if(!enabled)return;
+        if(irqDepth) {
+            if(opcode==0x4e73 && next==irqReturns[irqDepth-1]) {
+                --irqDepth;if(measuring)++irqExited;
+            }
+            return;
+        }
+        if(pc!=exits[0] && pc!=exits[1] && pc!=exits[2])return;
+        if(opcode!=(pc==exits[2]?0x4e75:0x4e73)){++faults;return;}
+        if(!depth){if(!prefix)++faults;else if(measuring)++prefixReturns;return;}
+        unsigned trap=traps[--depth];
+        if(measuring)++cost[trap].returns;
+    }
+    void write(FILE* f) const {
+        if(!enabled)return;
+        fprintf(f,"native_scope_prefix_returns %llu\n",(unsigned long long)prefixReturns);
+        fprintf(f,"native_scope_version 1\nnative_scope_faults %llu\nnative_scope_unscoped %llu\nnative_scope_irq_before %u\nnative_scope_irq_after %u\nnative_scope_irq_entered %llu\nnative_scope_irq_exited %llu\n",
+            (unsigned long long)faults,(unsigned long long)unscoped,irqBefore,irqDepth,
+            (unsigned long long)irqEntered,(unsigned long long)irqExited);
+        fprintf(f,"native_scope_text_low %u\nnative_scope_text_high %u\n",textLow,textHigh);
+        fprintf(f,"native_scope_exec_low %u\nnative_scope_exec_high %u\nnative_scope_supervisor %u\nnative_scope_privilege_calls %llu\n",execLow,execHigh,supervisor,(unsigned long long)privilegeCalls);
+        for(unsigned i=0;i<3;++i)fprintf(f,"native_scope_exit_%u %u\n",i,exits[i]);
+        for(unsigned i=0;i<4096;++i) {
+            unsigned after=0;for(unsigned j=0;j<depth;++j)if(traps[j]==i)++after;
+            const Cost& c=cost[i];
+            if(!c.units && !c.calls && !c.returns && !c.irq && !c.before && !after)continue;
+            fprintf(f,"native_%03x_units %llu\nnative_%03x_calls %llu\nnative_%03x_returns %llu\nnative_%03x_irq %llu\nnative_%03x_before %u\nnative_%03x_after %u\n",
+                i,(unsigned long long)c.units,i,(unsigned long long)c.calls,
+                i,(unsigned long long)c.returns,i,(unsigned long long)c.irq,i,c.before,i,after);
+            fprintf(f,"native_%03x_foreign %llu\n",i,(unsigned long long)c.foreign);
+        }
+    }
+};
